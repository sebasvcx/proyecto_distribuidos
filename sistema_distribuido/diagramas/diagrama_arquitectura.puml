@startuml
!theme plain
title Diagrama de Arquitectura - Sistema Distribuido de Préstamo de Libros

skinparam rectangle {
  BackgroundColor LightBlue
  BorderColor DarkBlue
}

skinparam component {
  BackgroundColor LightGreen
  BorderColor DarkGreen
}

skinparam database {
  BackgroundColor LightYellow
  BorderColor Orange
}

skinparam note {
  BackgroundColor LightCyan
  BorderColor DarkCyan
}

' ========= Red Docker (contiene los contenedores) =========
cloud "Red Docker\n(red_distribuida)" as Network {

  ' === Contenedor GC ===
  rectangle "Contenedor GC" as GC {
    component "Gestor de Carga" as GC_Service
    note right of GC_Service
      • Puerto 5001: REQ/REP (recibe de PS)
      • Puerto 5002: PUB/SUB (envía eventos)
      • REQ a Actor Préstamo (5004)
      • REQ a GA (5003)
      • Modo serial/multithread
    end note
  }

  ' === Contenedor GA ===
  rectangle "Contenedor GA" as GA {
    component "Gestor de Almacenamiento" as GA_Service
    note right of GA_Service
      • Puerto 5003: REP
      • Gestiona réplicas
      • Operaciones de BD
      • Failover automático
    end note
  }

  ' === Contenedor PS ===
  rectangle "Contenedor PS" as PS {
    component "Proceso Solicitante" as PS_Service
    note right of PS_Service
      • Lee solicitudes.txt
      • Envía solicitudes JSON
      • Registra métricas
      • Comunicación síncrona
    end note
  }

  ' === Contenedor Actor Préstamo ===
  rectangle "Contenedor Actor Préstamo" as ActorPrest {
    component "Actor Préstamo" as ActorPrest_Service
    note right of ActorPrest_Service
      • Puerto 5004: REP (recibe de GC)
      • REQ a GA (5003)
      • Procesa préstamos
      • Búsqueda de libros
    end note
  }

  ' === Contenedor Actor Devolución ===
  rectangle "Contenedor Actor Devolución" as ActorDev {
    component "Actor Devolución" as ActorDev_Service
    note right of ActorDev_Service
      • Suscribe a "devolucion"
      • REQ a GA (5003)
      • Procesa devoluciones
      • Failover automático
    end note
  }

  ' === Contenedor Actor Renovación ===
  rectangle "Contenedor Actor Renovación" as ActorRen {
    component "Actor Renovación" as ActorRen_Service
    note right of ActorRen_Service
      • Suscribe a "renovacion"
      • REQ a GA (5003)
      • Actualiza fechas
      • Failover automático
    end note
  }

  ' === Archivos Compartidos (bind mount) ===
  database "Archivos Compartidos" as DB {
    component "Réplica Primaria\nlibros.json" as LibrosPrimary
    component "Réplica Secundaria\nlibros.json" as LibrosSecondary
    component "solicitudes.txt" as SolicitudesFile
  }

  ' === Comunicación REQ/REP (Síncrona) ===
  PS_Service -[#red]-> GC_Service : REQ/REP\nPuerto 5001
  GC_Service -[#red]-> ActorPrest_Service : REQ/REP\nPuerto 5004
  ActorPrest_Service -[#red]-> GA_Service : REQ/REP\nPuerto 5003
  ActorDev_Service -[#red]-> GA_Service : REQ/REP\nPuerto 5003
  ActorRen_Service -[#red]-> GA_Service : REQ/REP\nPuerto 5003
  GC_Service -[#purple]-> GA_Service : REQ/REP\nPuerto 5003\n(health checks)

  ' === Comunicación PUB/SUB (Asíncrona) ===
  GC_Service -[#green]-> ActorDev_Service : PUB/SUB\nPuerto 5002\ntopic: devolucion
  GC_Service -[#green]-> ActorRen_Service : PUB/SUB\nPuerto 5002\ntopic: renovacion

  ' === Acceso a archivos ===
  PS_Service -[#orange]-> SolicitudesFile : Lee
  GA_Service -[#orange]-> LibrosPrimary : Lee/Escribe
  GA_Service -[#orange]-> LibrosSecondary : Replica\n(asíncrono)
}

' === Notas explicativas fuera de la nube ===
note top of PS_Service
**Patrón REQ/REP**
Comunicación síncrona
Request-Response
end note

note top of GC_Service
**Patrón PUB/SUB**
Comunicación asíncrona
Publisher-Subscriber
end note

note bottom of GA_Service
**Gestor de Almacenamiento**
Centraliza todas las operaciones
de base de datos
Réplicas con failover
end note

note right of ActorPrest_Service
**Actor Préstamo**
Procesa préstamos síncronos
Comunicación directa con GA
end note

@enduml